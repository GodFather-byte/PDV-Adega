<Window x:Class="PDV_Adega.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relatórios do PDV" Width="1240" Height="820" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="#F5F7F3" FontFamily="Segoe UI" Language="pt-BR">
  <Window.Resources>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#E5E9E3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="RowHeight" Value="34" />
      <Setter Property="ColumnHeaderHeight" Value="36" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HeadersVisibility" Value="Column" />
    </Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,18">
      <StackPanel><TextBlock Text="Relatórios" Foreground="#202B25" FontSize="23" FontWeight="Bold" /><TextBlock Text="Vendas, produtos e conferência de caixa" Foreground="#78817A" FontSize="12" Margin="0,4,0,0" /></StackPanel>
      <Button Content="Fechar" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="14,8" IsCancel="True" Background="White" Foreground="#465149" BorderBrush="#E5E9E3" BorderThickness="1" />
    </Grid>
    <Grid Grid.Row="1" Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="150" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="150" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <TextBlock Text="De" VerticalAlignment="Center" Foreground="#667069" FontSize="11" Margin="0,0,8,0" />
      <DatePicker x:Name="FromDatePicker" Grid.Column="1" Height="34" />
      <TextBlock Grid.Column="2" Text="Até" VerticalAlignment="Center" Foreground="#667069" FontSize="11" Margin="14,0,8,0" />
      <DatePicker x:Name="ToDatePicker" Grid.Column="3" Height="34" />
      <Button Grid.Column="4" Content="Aplicar período" Margin="12,0,0,0" Padding="13,0" Background="#345D47" Foreground="White" FontWeight="SemiBold" Click="ApplyFilter_Click" />
      <Button Grid.Column="5" Content="Exportar CSV" Margin="8,0,0,0" Padding="13,0" Background="White" Foreground="#345D47" BorderBrush="#E5E9E3" BorderThickness="1" Click="ExportCsv_Click" />
    </Grid>
    <TabControl x:Name="ReportTabs" Grid.Row="2" Background="Transparent">
      <TabItem Header="Resumo">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <UniformGrid Columns="5" Margin="0,0,0,14">
            <Border Background="White" BorderBrush="#E5E9E3" BorderThickness="1" CornerRadius="6" Padding="13" Margin="0,0,8,0"><StackPanel><TextBlock Text="Vendas" Foreground="#78817A" FontSize="10" /><TextBlock x:Name="SaleCountLabel" Foreground="#202B25" FontSize="20" FontWeight="Bold" Margin="0,5,0,0" /></StackPanel></Border>
            <Border Background="White" BorderBrush="#E5E9E3" BorderThickness="1" CornerRadius="6" Padding="13" Margin="0,0,8,0"><StackPanel><TextBlock Text="Subtotal" Foreground="#78817A" FontSize="10" /><TextBlock x:Name="SubtotalLabel" Foreground="#202B25" FontSize="18" FontWeight="Bold" Margin="0,5,0,0" /></StackPanel></Border>
            <Border Background="White" BorderBrush="#E5E9E3" BorderThickness="1" CornerRadius="6" Padding="13" Margin="0,0,8,0"><StackPanel><TextBlock Text="Descontos" Foreground="#78817A" FontSize="10" /><TextBlock x:Name="DiscountLabel" Foreground="#A3473B" FontSize="18" FontWeight="Bold" Margin="0,5,0,0" /></StackPanel></Border>
            <Border Background="White" BorderBrush="#E5E9E3" BorderThickness="1" CornerRadius="6" Padding="13" Margin="0,0,8,0"><StackPanel><TextBlock Text="Total vendido" Foreground="#78817A" FontSize="10" /><TextBlock x:Name="TotalLabel" Foreground="#345D47" FontSize="18" FontWeight="Bold" Margin="0,5,0,0" /></StackPanel></Border>
            <Border Background="White" BorderBrush="#E5E9E3" BorderThickness="1" CornerRadius="6" Padding="13"><StackPanel><TextBlock Text="Ticket médio" Foreground="#78817A" FontSize="10" /><TextBlock x:Name="AverageTicketLabel" Foreground="#202B25" FontSize="18" FontWeight="Bold" Margin="0,5,0,0" /></StackPanel></Border>
          </UniformGrid>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#E5E9E3" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,8,0">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="Vendas por dia" Foreground="#202B25" FontSize="13" FontWeight="Bold" Margin="0,0,0,9" /><DataGrid x:Name="DailyGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Data" Binding="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}" Width="*" /><DataGridTextColumn Header="Vendas" Binding="{Binding SaleCount}" Width="Auto" /><DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat={}{0:C}}" Width="*" /><DataGridTextColumn Header="Descontos" Binding="{Binding Discount, StringFormat={}{0:C}}" Width="*" /><DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:C}}" Width="*" /></DataGrid.Columns></DataGrid></Grid>
            </Border>
            <Border Grid.Column="1" Background="White" BorderBrush="#E5E9E3" BorderThickness="1" CornerRadius="6" Padding="14" Margin="8,0,0,0">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="Vendas por pagamento" Foreground="#202B25" FontSize="13" FontWeight="Bold" Margin="0,0,0,9" /><DataGrid x:Name="PaymentGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Forma" Binding="{Binding PaymentMethod}" Width="*" /><DataGridTextColumn Header="Vendas" Binding="{Binding SaleCount}" Width="Auto" /><DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:C}}" Width="*" /></DataGrid.Columns></DataGrid></Grid>
            </Border>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="Vendas">
        <DataGrid x:Name="SalesGrid" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Venda" Binding="{Binding Number, StringFormat={}{0:00000}}" Width="70" /><DataGridTextColumn Header="Data e hora" Binding="{Binding SoldAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="150" /><DataGridTextColumn Header="Cliente" Binding="{Binding Customer}" Width="*" /><DataGridTextColumn Header="Pagamento" Binding="{Binding PaymentMethod}" Width="110" /><DataGridTextColumn Header="Itens" Binding="{Binding ItemCount}" Width="60" /><DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat={}{0:C}}" Width="110" /><DataGridTextColumn Header="Desconto" Binding="{Binding Discount, StringFormat={}{0:C}}" Width="100" /><DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:C}}" Width="110" /><DataGridTextColumn Header="Caixa" Binding="{Binding CashSessionNumber}" Width="70" /></DataGrid.Columns></DataGrid>
      </TabItem>
      <TabItem Header="Itens">
        <DataGrid x:Name="ItemsGrid" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Venda" Binding="{Binding SaleNumber, StringFormat={}{0:00000}}" Width="70" /><DataGridTextColumn Header="Data e hora" Binding="{Binding SoldAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="145" /><DataGridTextColumn Header="Produto" Binding="{Binding ProductName}" Width="*" /><DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="110" /><DataGridTextColumn Header="Unidades" Binding="{Binding Quantity}" Width="80" /><DataGridTextColumn Header="Preço unitário" Binding="{Binding UnitPrice, StringFormat={}{0:C}}" Width="115" /><DataGridTextColumn Header="Bruto" Binding="{Binding Gross, StringFormat={}{0:C}}" Width="110" /><DataGridTextColumn Header="Desconto" Binding="{Binding Discount, StringFormat={}{0:C}}" Width="110" /><DataGridTextColumn Header="Líquido" Binding="{Binding Net, StringFormat={}{0:C}}" Width="110" /></DataGrid.Columns></DataGrid>
      </TabItem>
      <TabItem Header="Produtos">
        <DataGrid x:Name="ProductsGrid" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Produto" Binding="{Binding ProductName}" Width="*" /><DataGridTextColumn Header="Unidades" Binding="{Binding Quantity}" Width="100" /><DataGridTextColumn Header="Venda bruta" Binding="{Binding Gross, StringFormat={}{0:C}}" Width="150" /><DataGridTextColumn Header="Desconto rateado" Binding="{Binding Discount, StringFormat={}{0:C}}" Width="150" /><DataGridTextColumn Header="Venda líquida" Binding="{Binding Net, StringFormat={}{0:C}}" Width="150" /></DataGrid.Columns></DataGrid>
      </TabItem>
      <TabItem Header="Categorias">
        <DataGrid x:Name="CategoriesGrid" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="*" /><DataGridTextColumn Header="Unidades" Binding="{Binding Quantity}" Width="120" /><DataGridTextColumn Header="Venda bruta" Binding="{Binding Gross, StringFormat={}{0:C}}" Width="160" /><DataGridTextColumn Header="Desconto rateado" Binding="{Binding Discount, StringFormat={}{0:C}}" Width="160" /><DataGridTextColumn Header="Venda líquida" Binding="{Binding Net, StringFormat={}{0:C}}" Width="160" /></DataGrid.Columns></DataGrid>
      </TabItem>
      <TabItem Header="Estoque">
        <DataGrid x:Name="InventoryGrid" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Código de barras" Binding="{Binding Barcode}" Width="150" /><DataGridTextColumn Header="Produto" Binding="{Binding ProductName}" Width="*" /><DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="130" /><DataGridTextColumn Header="Preço" Binding="{Binding Price, StringFormat={}{0:C}}" Width="130" /><DataGridTextColumn Header="Saldo" Binding="{Binding Stock}" Width="80" /><DataGridTextColumn Header="Valor a preço de venda" Binding="{Binding InventoryValue, StringFormat={}{0:C}}" Width="170" /></DataGrid.Columns></DataGrid>
      </TabItem>
      <TabItem Header="Caixas">
        <DataGrid x:Name="SessionsGrid" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Caixa" Binding="{Binding Number, StringFormat={}{0:00000}}" Width="70" /><DataGridTextColumn Header="Abertura" Binding="{Binding OpenedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="145" /><DataGridTextColumn Header="Fechamento" Binding="{Binding ClosedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="145" /><DataGridTextColumn Header="Fundo inicial" Binding="{Binding OpeningCash, StringFormat={}{0:C}}" Width="120" /><DataGridTextColumn Header="Vendas em dinheiro" Binding="{Binding CashSales, StringFormat={}{0:C}}" Width="145" /><DataGridTextColumn Header="Suprimentos" Binding="{Binding Supplies, StringFormat={}{0:C}}" Width="120" /><DataGridTextColumn Header="Sangrias" Binding="{Binding Withdrawals, StringFormat={}{0:C}}" Width="110" /><DataGridTextColumn Header="Esperado" Binding="{Binding Expected, StringFormat={}{0:C}}" Width="120" /><DataGridTextColumn Header="Contado" Binding="{Binding Counted, StringFormat={}{0:C}}" Width="120" /><DataGridTextColumn Header="Diferença" Binding="{Binding Difference, StringFormat={}{0:C}}" Width="120" /><DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="90" /></DataGrid.Columns></DataGrid>
      </TabItem>
      <TabItem Header="Movimentos">
        <DataGrid x:Name="MovementsGrid" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Data e hora" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="160" /><DataGridTextColumn Header="Caixa" Binding="{Binding SessionNumber, StringFormat={}{0:00000}}" Width="80" /><DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="130" /><DataGridTextColumn Header="Descrição" Binding="{Binding Note}" Width="*" /><DataGridTextColumn Header="Valor" Binding="{Binding Amount, StringFormat={}{0:C}}" Width="140" /></DataGrid.Columns></DataGrid>
      </TabItem>
    </TabControl>
    <TextBlock x:Name="PeriodLabel" Grid.Row="3" Foreground="#78817A" FontSize="10" Margin="2,10,0,0" />
  </Grid>
</Window>
