<Window x:Class="PDV_Adega.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ativar PDV-Adega" Width="460" Height="390" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#F5F7F3" FontFamily="Segoe UI">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Ativação do PDV" Foreground="#202B25" FontSize="24" FontWeight="Bold" />
    <TextBlock Grid.Row="1" Text="Informe o endereço do servidor e a chave fornecida pelo administrador." TextWrapping="Wrap" Foreground="#78817A" Margin="0,8,0,20" />
    <StackPanel Grid.Row="2">
      <TextBlock Text="Endereço do painel/servidor" Foreground="#465149" FontSize="12" FontWeight="SemiBold" />
      <TextBox x:Name="ServerUrlBox" Margin="0,5,0,14" Padding="9" FontSize="13" Text="https://" />
      <TextBlock Text="Chave da licença" Foreground="#465149" FontSize="12" FontWeight="SemiBold" />
      <TextBox x:Name="LicenseKeyBox" Margin="0,5,0,0" Padding="9" FontSize="13" />
    </StackPanel>
    <TextBlock Grid.Row="3" Text="A ativação exige conexão. Após ativar, o PDV pode operar offline por até 7 dias." TextWrapping="Wrap" Foreground="#78817A" FontSize="11" Margin="0,16,0,0" />
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
      <Button Content="Sair" Width="90" Height="38" Margin="0,0,8,0" Background="White" Foreground="#465149" Click="Cancel_Click" />
      <Button Content="Ativar licença" Width="130" Height="38" Background="#345D47" Foreground="White" FontWeight="SemiBold" Click="Activate_Click" />
    </StackPanel>
  </Grid>
</Window>
