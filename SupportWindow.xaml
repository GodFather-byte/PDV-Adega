<Window x:Class="PDV_Adega.SupportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Suporte técnico" Width="760" Height="720" MinWidth="680" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#F5F7F3" FontFamily="Segoe UI">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,14">
      <TextBlock Text="Suporte técnico" Foreground="#202B25" FontSize="22" FontWeight="Bold" />
      <TextBlock Text="Abra um chamado, acompanhe as respostas e combine sessões com uma ferramenta remota externa." Foreground="#78817A" TextWrapping="Wrap" Margin="0,5,0,0" />
    </StackPanel>
    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
      <TabItem Header="Novo chamado">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Assunto" FontWeight="SemiBold" Foreground="#465149" />
            <TextBox x:Name="SubjectBox" Margin="0,5,0,12" Padding="8" MaxLength="120" />
            <TextBlock Text="Descreva o problema (não inclua senhas, dados de clientes ou informações de pagamento)." FontWeight="SemiBold" Foreground="#465149" TextWrapping="Wrap" />
            <TextBox x:Name="DescriptionBox" Height="130" Margin="0,5,0,12" Padding="8" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="4000" />
            <Border Background="White" BorderBrush="#E5E9E3" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Diagnóstico opcional" FontWeight="SemiBold" Foreground="#202B25" />
                <TextBlock Text="Se consentir, enviaremos um pacote com versão do PDV, versão do Windows, nome e identificador deste computador e logs de erros do aplicativo (que podem conter caminhos locais). Ele não inclui vendas, estoque, produtos, clientes, caixa, impressora ou chave de licença. O pacote é apagado após 30 dias." TextWrapping="Wrap" Foreground="#78817A" FontSize="11" Margin="0,5,0,8" />
                <CheckBox x:Name="DiagnosticsConsentCheck" Content="Concordo em enviar este pacote de diagnóstico junto com o chamado." Foreground="#465149" />
              </StackPanel>
            </Border>
            <Border Background="#EAF1EB" CornerRadius="5" Padding="12" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Suporte remoto externo" FontWeight="SemiBold" Foreground="#202B25" />
                <TextBlock Text="O PDV não abre conexão remota. Se marcar, autoriza a equipe a combinar com você uma sessão usando uma ferramenta externa. Você mesmo iniciará a ferramenta e poderá encerrar a sessão a qualquer momento. Nunca informe senhas de acesso permanente." TextWrapping="Wrap" Foreground="#465149" FontSize="11" Margin="0,5,0,8" />
                <CheckBox x:Name="RemoteConsentCheck" Content="Solicito suporte remoto e autorizo uma sessão temporária combinada para este chamado." Foreground="#465149" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="CreateStatusLabel" Foreground="#A3473B" TextWrapping="Wrap" Margin="0,0,0,8" />
            <Button Content="Enviar chamado" Width="145" Height="38" HorizontalAlignment="Right" Background="#345D47" Foreground="White" FontWeight="SemiBold" Click="CreateTicket_Click" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Meus chamados">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="145" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Atualize para verificar respostas da equipe." Foreground="#78817A" VerticalAlignment="Center" />
            <Button Content="Atualizar" DockPanel.Dock="Right" Padding="10,6" Background="#EAF1EB" Foreground="#345D47" Click="RefreshTickets_Click" />
          </DockPanel>
          <ListBox x:Name="TicketsList" Grid.Row="1" SelectionChanged="TicketsList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="2">
                  <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" Foreground="#202B25" />
                  <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#78817A" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border Grid.Row="2" Background="White" BorderBrush="#E5E9E3" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,10,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock x:Name="TicketDetailsLabel" Foreground="#465149" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="TicketMessagesLabel" Foreground="#465149" TextWrapping="Wrap" Margin="0,8,0,0" />
              </StackPanel>
            </ScrollViewer>
          </Border>
          <TextBox x:Name="ReplyBox" Grid.Row="3" Height="58" Padding="8" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="2000" IsEnabled="False" />
          <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock x:Name="TicketsStatusLabel" Foreground="#A3473B" VerticalAlignment="Center" TextWrapping="Wrap" Width="410" />
            <Button Content="Enviar resposta" Padding="12,8" Background="#345D47" Foreground="White" Click="Reply_Click" IsEnabled="False" x:Name="ReplyButton" />
          </StackPanel>
        </Grid>
      </TabItem>
    </TabControl>
    <TextBlock Grid.Row="2" Text="A equipe registra o histórico do chamado. Dados de diagnóstico só são enviados quando você autoriza no envio." Foreground="#78817A" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0" />
  </Grid>
</Window>
