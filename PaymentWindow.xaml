<Window x:Class="PDV_Adega.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pagamento" Width="440" Height="500" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F5F7F3" FontFamily="Segoe UI">
  <Grid Margin="25">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Finalizar venda" Foreground="#202B25" FontSize="20" FontWeight="Bold" />
      <TextBlock Text="Selecione a forma de pagamento" Foreground="#78817A" FontSize="12" Margin="0,5,0,0" />
    </StackPanel>
    <UniformGrid Grid.Row="1" Columns="3" Margin="0,21,0,18">
      <RadioButton x:Name="PixOption" GroupName="Payment" IsChecked="True" Checked="PaymentOption_Checked" Margin="0,0,7,0">
        <Border x:Name="PixBorder" Background="#EAF1EB" BorderBrush="#345D47" BorderThickness="1" CornerRadius="7" Padding="8,12">
          <StackPanel HorizontalAlignment="Center"><TextBlock Text="◇" Foreground="#345D47" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="Pix" Foreground="#345D47" FontSize="11" FontWeight="SemiBold" /></StackPanel>
        </Border>
      </RadioButton>
      <RadioButton x:Name="CardOption" GroupName="Payment" Checked="PaymentOption_Checked" Margin="3,0">
        <Border x:Name="CardBorder" Background="White" BorderBrush="#E5E9E3" BorderThickness="1" CornerRadius="7" Padding="8,12">
          <StackPanel HorizontalAlignment="Center"><TextBlock Text="▰" Foreground="#68766C" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="Cartão" Foreground="#5E6861" FontSize="11" FontWeight="SemiBold" /></StackPanel>
        </Border>
      </RadioButton>
      <RadioButton x:Name="CashOption" GroupName="Payment" Checked="PaymentOption_Checked" Margin="7,0,0,0">
        <Border x:Name="CashBorder" Background="White" BorderBrush="#E5E9E3" BorderThickness="1" CornerRadius="7" Padding="8,12">
          <StackPanel HorizontalAlignment="Center"><TextBlock Text="R$" Foreground="#68766C" FontSize="17" HorizontalAlignment="Center" /><TextBlock Text="Dinheiro" Foreground="#5E6861" FontSize="11" FontWeight="SemiBold" /></StackPanel>
        </Border>
      </RadioButton>
    </UniformGrid>
    <StackPanel x:Name="CashPanel" Grid.Row="2" Visibility="Collapsed">
      <TextBlock Text="Valor recebido" Foreground="#78817A" FontSize="11" Margin="0,0,0,6" />
      <TextBox x:Name="CashReceivedBox" Height="38" Padding="10,7" FontSize="14" BorderBrush="#E5E9E3" TextChanged="CashReceivedBox_TextChanged" />
      <TextBlock x:Name="ChangeLabel" Text="Troco: R$ 0,00" Foreground="#345D47" FontSize="11" FontWeight="SemiBold" Margin="0,7,0,0" />
    </StackPanel>
    <Border Grid.Row="3" BorderBrush="#E5E9E3" BorderThickness="0,1,0,0" VerticalAlignment="Bottom" Padding="0,14,0,0" Margin="0,0,0,16">
      <Grid><TextBlock Text="Total a pagar" Foreground="#202B25" FontSize="13" FontWeight="SemiBold" /><TextBlock x:Name="TotalLabel" HorizontalAlignment="Right" Foreground="#202B25" FontSize="16" FontWeight="Bold" /></Grid>
    </Border>
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Button Content="Cancelar" Height="42" Margin="0,0,5,0" Background="White" Foreground="#465149" BorderBrush="#E5E9E3" BorderThickness="1" IsCancel="True" />
      <Button Grid.Column="1" Content="Confirmar pagamento" Height="42" Margin="5,0,0,0" Background="#345D47" Foreground="White" FontWeight="Bold" Click="ConfirmPayment_Click" IsDefault="True" />
    </Grid>
  </Grid>
</Window>
