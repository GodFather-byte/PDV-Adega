<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>PDV_Adega</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Ativação por licença desligada por padrão. Para exigir: dotnet publish -p:EnableLicensing=true -->
    <EnableLicensing Condition="'$(EnableLicensing)' == ''">false</EnableLicensing>
    <DefineConstants Condition="'$(EnableLicensing)' == 'true'">$(DefineConstants);LICENSING</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="LicensingServer/**/*.cs" />
  </ItemGroup>
</Project>
