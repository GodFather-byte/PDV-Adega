<Application x:Class="PDV_Adega.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="InkBrush" Color="#202B25" />
    <SolidColorBrush x:Key="MutedBrush" Color="#78817A" />
    <SolidColorBrush x:Key="LineBrush" Color="#E5E9E3" />
    <SolidColorBrush x:Key="GreenBrush" Color="#345D47" />
    <SolidColorBrush x:Key="GreenPaleBrush" Color="#EAF1EB" />
    <SolidColorBrush x:Key="PaperBrush" Color="#F5F7F3" />
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </Application.Resources>
</Application>
